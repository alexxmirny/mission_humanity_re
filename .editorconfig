# EditorConfig (editorconfig.org) -- honored natively by VS 2022, VS Code, PyCharm, etc.
# Applies as files are EDITED; it never mass-rewrites anything.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,c,h}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{json,yaml,yml,js}]
indent_style = space
indent_size = 2

[*.md]
# trailing double-space is a hard line break in Markdown -- don't strip it
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
