// mh/config/ini_keys.def -- THE REGISTRY of every key mh.dll (and the modules it hosts) reads from
// mh_net.ini. One row per key. RL1 (v0.2.0 plan workstream A, decisions D9/D10/D15).
//
// X-MACRO FILE. Include it with MH_INI_KEY defined, then #undef it:
//
//     #define MH_INI_KEY(sec, key, type, dflt, cls, label, subtab, options, flags) ...
//     #include "mh/config/ini_keys.def"
//     #undef MH_INI_KEY
//
// The consumer declares the bare enumerators the rows use (prefixed, so they cannot collide with
// <windows.h>'s INT/BOOL): T_INT T_BOOL T_STRING T_ENUM T_HOTKEY; C_USER C_DEV C_FIXED; S_NONE
// S_DISPLAY S_LANGUAGE S_MULTIPLAYER S_DIAGNOSTICS S_UPDATES; and the flag bits F_NONE=0 F_EXPERIMENTAL
// F_RESTART F_PENDING (rows OR them: `F_EXPERIMENTAL|F_RESTART`). Every other column is a string literal.
// tools/gen_ini_registry.py parses this file (it reads no C++ semantics, only these rows), so keep
// a row on ONE line and keep the nine columns in this order:
//
//   sec      the [section]                           key      the key name
//   type     T_INT | T_BOOL (0/1) | T_STRING | T_ENUM (options lists the values) | T_HOTKEY
//   dflt     the value used when the key is absent, as text. For a `fixed` row it is the SHIP value the
//            shipped build hardcodes (RL2), which for [pause] key (0 = disabled) is NOT the code default.
//   cls      C_USER  a player setting; the launcher shows it (src/launcher/settings_schema.json).
//            C_DEV   a developer/rig knob: ignored with a log line in the shipped build unless
//                    `[dev] unlock=1` (D10). The default class: a new key is dev until someone decides.
//            C_FIXED hardcoded to its ship value in the shipped build (D15); an ini value is ignored
//                    (logged once as FIXED) unless `[dev] unlock=1` -- the rig's fix-off negatives.
//            Enforced at run time by mh_common/include/mh_ini_gate.h (RL2), which includes THIS file
//            to build its table. `[dev] unlock` and `[log] level` are always read whatever their class.
//   label    launcher label id (user rows only; the string table lives with the launcher, RL13)
//   subtab   S_DISPLAY | S_LANGUAGE | S_MULTIPLAYER | S_DIAGNOSTICS | S_UPDATES (user rows only)
//   options  T_ENUM: the allowed values joined by `|`, in display order. T_INT: suggested choices.
//   flags    F_EXPERIMENTAL  shown with an "experimental" pill
//            F_RESTART       takes effect only on the next game start
//            F_PENDING       registered ahead of its reader: gen_ini_registry.py --check does not
//                            demand a read in the code yet (no row carries it now: RL6/RL2 landed the readers)
//
// The user-class set is the approved settings table of docs/v020-release-plan.md section E and nothing
// else; `gen_ini_registry.py --check` fails when a key is read in src/mh_dll without a row here, when a
// row is never read, and when mh_net.example.ini names a key that is not registered.
//
// NOT a registry row: names built at run time. [debug] page.<name>.items (gfx_overlay), the
// RETIRED_KNOBS probes (net_lockstep) and the retired-section probes (config.h) are not settings.
// Dev notes: [input] codepage is DERIVED from [lang] pack by the launcher/runtime, so it is `dev`, not
// a player setting. [video] backend also accepts own|null (dev); the player sees system|d3d11|gdi.

// ---- PLAYER SETTINGS (class C_USER), in the launcher's display order (plan section E) ----
MH_INI_KEY("video", "window", T_ENUM, "windowed", C_USER, "video.window", S_DISPLAY, "borderless|windowed", F_NONE)
MH_INI_KEY("video", "scale", T_ENUM, "fit", C_USER, "video.scale", S_DISPLAY, "fit|integer", F_NONE)
MH_INI_KEY("video", "filter", T_ENUM, "point", C_USER, "video.filter", S_DISPLAY, "area|sharp|linear|point", F_NONE)
MH_INI_KEY("video", "vsync", T_BOOL, "0", C_USER, "video.vsync", S_DISPLAY, "", F_NONE)
MH_INI_KEY("video", "fps_limit", T_INT, "60", C_USER, "video.fps_limit", S_DISPLAY, "60|0", F_NONE)
MH_INI_KEY("video", "mouse_clip", T_BOOL, "1", C_USER, "video.mouse_clip", S_DISPLAY, "", F_NONE)
MH_INI_KEY("video", "picker", T_BOOL, "0", C_USER, "video.picker", S_DISPLAY, "", F_EXPERIMENTAL|F_RESTART)
MH_INI_KEY("lang", "pack", T_STRING, "", C_USER, "lang.pack", S_LANGUAGE, "", F_RESTART)
MH_INI_KEY("net", "relay", T_STRING, "", C_USER, "net.relay", S_MULTIPLAYER, "", F_NONE)
MH_INI_KEY("net", "force_relay", T_BOOL, "0", C_USER, "net.force_relay", S_MULTIPLAYER, "", F_NONE)
MH_INI_KEY("hud", "net_indicator", T_BOOL, "1", C_USER, "hud.net_indicator", S_MULTIPLAYER, "", F_NONE)
MH_INI_KEY("hud", "net_indicator_key", T_HOTKEY, "Ctrl+Alt+N", C_USER, "hud.net_indicator_key", S_MULTIPLAYER, "", F_NONE)
MH_INI_KEY("net", "port", T_INT, "6501", C_USER, "net.port", S_MULTIPLAYER, "", F_RESTART)
MH_INI_KEY("log", "level", T_ENUM, "normal", C_USER, "log.level", S_DIAGNOSTICS, "quiet|normal|debug", F_NONE)
MH_INI_KEY("video", "backend", T_ENUM, "system", C_USER, "video.backend", S_DIAGNOSTICS, "system|d3d11|gdi", F_RESTART)
MH_INI_KEY("input", "backend", T_ENUM, "system", C_USER, "input.backend", S_DIAGNOSTICS, "system|own", F_RESTART)
